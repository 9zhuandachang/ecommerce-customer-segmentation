# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual environments
venv/
env/
ENV/
.env
.venv

# IDE & editors
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
.DS_Store

# Agent / Tool local directories
.agents/
.claude/

# Data files (raw and processed data should not be pushed to GitHub)
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep

# Large models / experiment checkpoints
models/*.pkl
!models/.gitkeep

# Logs and temporary files
*.log
